# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo

# env files - never commit real secrets
.env
.env.*
!.env.example

# local runtime data (sqlite db, state files, logs) - matched by extension/
# known filename, not a blanket "data/" directory rule (that would also hide
# any real checked-in data/ folder a package adds later).
data/ebay-price-state.json
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.log

# editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# test/coverage
coverage/
