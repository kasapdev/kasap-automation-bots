# --- Discord ---
# Discord channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL.
# Keep this secret, never commit it. If unset, warnings are only printed to the console.
DISCORD_WEBHOOK_URL=

# --- Config ---
# Path to a JSON file describing the domains/hosts to monitor and the warning
# threshold, e.g.:
# { "domains": ["example.com"], "sslHosts": ["example.com"], "warnDaysThreshold": 30 }
# See expiry-config.example.json for the expected shape.
# EXPIRY_CONFIG_FILE=./expiry-config.json
