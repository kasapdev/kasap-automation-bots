# --- Discord ---
# Discord Developer Portal (https://discord.com/developers/applications) >
# your application > Bot > Token. Keep this secret, never commit it.
DISCORD_TOKEN=

# Category channel new ticket channels are created under (right-click the
# category > Copy Category ID; requires Developer Mode on in Discord settings).
# Leave empty to create ticket channels at the guild root.
TICKET_CATEGORY_ID=

# Role that gets ticket-channel access alongside the ticket opener (right-click
# the role in Server Settings > Roles > Copy Role ID; requires Developer Mode).
# Leave empty to skip granting a staff role access.
STAFF_ROLE_ID=

# Channel where the "open a ticket" button/command message lives (right-click
# the channel > Copy Channel ID; requires Developer Mode on). Informational -
# not currently enforced by the bot itself.
OPEN_TICKET_CHANNEL_ID=

# Maximum number of tickets a single user may have open at once.
# MAX_TICKETS_PER_USER=1
