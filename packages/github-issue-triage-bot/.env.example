# Local dev/testing only. When running as a GitHub Action, inputs and
# secrets come from the Actions runtime (the workflow YAML + `env:`), not
# from a .env file — this file is purely a convenience for manually
# exercising src/githubApi.ts or src/run.ts against a real repo locally.

# Personal access token with `repo` scope (or a fine-grained token with
# issues read/write) for local manual testing.
# NEVER commit a real token — this file only documents the variable name.
GITHUB_TOKEN=

# Note: label-rules-path and similarity-threshold are GitHub Action *inputs*,
# not environment variables. They are configured under `with:` in the
# consuming repo's workflow YAML (see action.yml / README.md), not here.
