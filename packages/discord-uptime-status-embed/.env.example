# --- Discord ---
# Discord Developer Portal (https://discord.com/developers/applications) >
# your application > Bot > Token. Keep this secret, never commit it.
DISCORD_TOKEN=

# Channel the live status message lives in (right-click the channel >
# Copy Channel ID; requires Developer Mode on in Discord settings).
STATUS_CHANNEL_ID=

# ID of the existing status message to edit in place, if known. Leave empty on
# first run: the bot will search the channel's pinned messages for one it
# posted before, or create+pin a new one and print its ID to the console.
# Copy that ID back into this variable afterwards so restarts reuse the same
# message instead of creating a new one every time.
STATUS_MESSAGE_ID=

# --- Targets ---
# Path to a JSON file describing the servers to monitor, e.g.:
# [{ "name": "Minecraft #1", "host": "1.2.3.4", "port": 25565 }]
# See status-targets.example.json for the expected shape.
# STATUS_TARGETS_FILE=./status-targets.json

# --- Timing ---
# Per-server TCP connect timeout, in milliseconds.
CHECK_TIMEOUT_MS=5000
# How often to re-check all targets and refresh the embed, in milliseconds.
POLL_INTERVAL_MS=60000
