# Local dev/testing only. Never commit a real token.
# A GitHub Personal Access Token with `repo` scope (or a fine-grained token with
# contents:write + pull-requests:read on the target repo).
GITHUB_TOKEN=

# Note: `current-tag` and `previous-tag` are GitHub Action *inputs* supplied by the
# consumer workflow YAML (see README.md), not environment variables — they are not
# listed here because they have no meaningful local-dev env-var equivalent.
