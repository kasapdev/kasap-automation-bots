# --- Discord ---
# Discord channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL.
# Keep this secret, never commit it. If unset, the bot runs in dry-run mode and
# prints the status report to the console instead of posting it.
DISCORD_WEBHOOK_URL=

# --- Targets ---
# Path to a JSON file describing the hosts/ports to monitor, e.g.:
# [{ "name": "Minecraft #1", "host": "1.2.3.4", "port": 25565 }]
# See uptime-targets.example.json for the expected shape.
# UPTIME_TARGETS_FILE=./uptime-targets.json

# --- Timing ---
# Per-target TCP connect timeout, in milliseconds.
CHECK_TIMEOUT_MS=5000
# How often to run a check pass when started with --watch / WATCH=true, in milliseconds.
POLL_INTERVAL_MS=300000
