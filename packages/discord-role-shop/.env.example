# --- Discord ---
# Discord Developer Portal (https://discord.com/developers/applications) >
# your application > Bot > Token. Keep this secret, never commit it.
DISCORD_TOKEN=

# --- Database ---
# Where this bot's SQLite store (point balances + purchase history) lives.
SHOP_DB_PATH=./data/role-shop.sqlite

# --- Shop ---
# Path to the JSON price list (see shop-config.example.json for the shape).
# Copy it to shop-config.json and fill in your real role IDs/prices.
SHOP_CONFIG_FILE=./shop-config.json

# --- Point economy ---
# Points awarded per eligible message (subject to the cooldown below).
POINTS_PER_MESSAGE=1
# Minimum milliseconds between point-earning messages per user, per guild.
MESSAGE_COOLDOWN_MS=60000
