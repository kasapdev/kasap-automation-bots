# --- eBay Developer Program ---
# Get a client ID and secret at https://developer.ebay.com/my/keys (My Account >
# Application Keys). Use your PRODUCTION keyset, not the sandbox one - the Browse
# API item endpoint this tool calls (api.ebay.com) is the production endpoint, and
# sandbox item IDs won't resolve there. Keep both secret, never commit them.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Discord ---
# Discord channel Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Keep this secret, never commit it - anyone with the URL can post to the channel.
DISCORD_WEBHOOK_URL=

# --- Watched items ---
# Path to a local JSON file listing the eBay items to watch, e.g.
# [{ "itemId": "v1|123456789|0", "label": "Example item" }, ...].
# See ebay-items.example.json for the exact shape. This file is your own config data
# and is not committed - copy the example and fill in real item IDs.
# EBAY_ITEMS_FILE=./ebay-items.json

# Where last-seen prices are stored between runs, so a price drop can be detected on
# the next check. The parent directory is created automatically if it doesn't exist.
# EBAY_STATE_FILE=./data/ebay-price-state.json

# How often to re-check prices when running with --watch (or WATCH=true), in
# milliseconds. Default is 900000 (15 minutes).
# POLL_INTERVAL_MS=900000
